# TalentAI backend - environment variables.
# Copy to .env (untracked) and fill in real values for local dev.
# In deployed environments these are set via the platform's own
# secret/config management, not this file.

# --- Profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Server ---
SERVER_PORT=8080

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=talentai
DB_USE_SSL=false
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
# SECRETS: DB_USERNAME / DB_PASSWORD are NOT set here. Put them in Backend/.env.local
# for local dev (see .env.local.example), and in AWS Secrets Manager when deployed.

# --- JWT ---
# JWT_SECRET is a SECRET (>=32 chars) — provide via .env.local locally / Secrets Manager in AWS.
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# --- Mail ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- AI service ---
AI_PROVIDER_BASE_URL=
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=30000

# --- File storage ---
FILE_UPLOAD_PATH=/var/talentai/uploads/resumes
FILE_MAX_SIZE_MB=10

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Logging ---
LOG_LEVEL=INFO
LOG_LEVEL_APP=DEBUG

# --- Swagger / Actuator ---
SWAGGER_UI_ENABLED=true
ACTUATOR_HEALTH_DETAILS=when-authorized
