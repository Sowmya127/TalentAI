# TalentAI backend — LOCAL SECRETS template.
# Copy to .env.local (gitignored) and fill in real values for local development.
# These are the SAME keys stored in AWS Secrets Manager for deployed environments;
# they are intentionally kept OUT of .env so secrets never sit in the shared config.
#
# start-backend.ps1 loads .env.local after .env.

DB_USERNAME=talentai_app
DB_PASSWORD=
# Must be at least 32 characters (256 bits) — HMAC-SHA256 rejects shorter keys.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
